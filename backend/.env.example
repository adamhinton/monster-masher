# ______________________
# Example local env file to show all expected env vars with safe placeholder values. 
# The real `.env` file is gitignored and should never be committed with real secrets.
# ______________________

# Django core
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sentry (optional in local dev)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Connection string for Supabase Postgres. Use direct connection or session pooler.
# Never use the transaction pooler (port 6543) — Django requires prepared statement support.
# Encode special characters in the password with urllib.parse.quote_plus().
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres

# Supabase project URL. Used for JWT verification in Django.
SUPABASE_URL=https://your-project-ref.supabase.co
# Audience claim expected in Supabase access tokens (default is fine).
SUPABASE_AUTH_AUDIENCE=authenticated
# JWT signing algorithm. Check Supabase Dashboard → Authentication → JWT Signing Keys.
# ES256 (Elliptic Curve, recommended for new projects) or RS256 (RSA).
SUPABASE_JWT_ALGORITHM=ES256

# Supabase storage bucket settings I used:
# Name: monster-images
# Public: true
# Allowed MIME types: image/*
# File size limit: 10MB
SUPABASE_STORAGE_BUCKET=monster-images

SUPABASE_SECRET_KEY=my-supabase-secret-key

# Future phases — listed here for discoverability, not yet used
# SUPABASE_ANON_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_STORAGE_BUCKET=
# IMAGE_GENERATION_MODE=fake
# IMAGE_PROVIDER_API_KEY=
