# ______________________
# Example local env file to show all expected env vars with safe placeholder values. 
# The real `.env` file is gitignored and should never be committed with real secrets.
# ______________________

# Django core
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sentry (optional in local dev)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Supabase connection string
# Use session pooler (direct connection unusable from Render/Vercel due to IPv6-only)
DATABASE_URL=


# Future phases — listed here for discoverability, not yet used
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=
# IMAGE_GENERATION_MODE=fake
# IMAGE_PROVIDER_API_KEY=
