```env
# Frontend
NEXT_PUBLIC_DJANGO_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Backend
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Maximum number of image generation jobs a single user can create in a rolling 24-hour window. Defaults to 6. Set MAX_GENERATIONS_PER_DAY in the environment to override (e.g. higher in staging, lower in production if needed).
MAX_GENERATIONS_PER_DAY=6

# Image generation stuff

# Image generation calls; only necessary if IMAGE_GENERATION_MODE is set to "real". This is a real API key.


# Supabase storage bucket settings I used:
# Name: monster-images
# Public: true
# Allowed MIME types: image/*
# File size limit: 10MB
SUPABASE_STORAGE_BUCKET=monster-images

SUPABASE_SECRET_KEY=your-supabase-secret-key

# ___IMAGE GENERATION___
IMAGE_GENERATION_MODE=fake # or "real" if you want to make real API calls to the image generation endpoint
# Vercel API gateway - Image generation calls; only necessary if IMAGE_GENERATION_MODE is set to "real". This is a real API key.
# Vercel sdk requires this be called AI_GATEWAY_API_KEY
AI_GATEWAY_API_KEY=your-vercel-api-gateway-key
AI_IMAGE_MODEL=your-ai-image-model-name # openai/gpt-image-2 is what I use
OPENAI_API_KEY=your-openai-api-key # For image generation prompt moderation; see moderation.ts

# Emailing user when monster image is done generating
# resend.com - need an authorized auth domain; I use auth.adam-hinton.com
RESEND_API_KEY=your-resend-api-key

# Also need, among possibly other things:
# - A Resend project for emails