# ─────────────────────────────────────────────────────────────────────────────
# Monster Masher — combined environment variable reference
#
# This file documents ALL env vars used across the project.
# There is no single .env file — each app has its own:
#
#   Frontend vars  →  frontend/.env.local
#   Backend vars   →  backend/.env
#
# Both files are gitignored. Never commit them with real secrets.
# On Render / Vercel, set env vars through the service dashboard instead.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# FRONTEND  →  frontend/.env.local
# ═════════════════════════════════════════════════════════════════════════════

# ── Public (inlined by Next.js and exposed to the browser) ───────────────────

# Django API base URL
NEXT_PUBLIC_DJANGO_API_BASE_URL=http://localhost:8000

# Supabase project URL and publishable (anon) key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# App's own base URL (used for metadata and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Build-time only ──────────────────────────────────────────────────────────

# Sentry source-map upload token (only needed for production builds)
SENTRY_AUTH_TOKEN=

# ── Server-side only (Next.js route handlers and middleware) ─────────────────

# Image generation mode: "fake" skips real API calls; "real" calls OpenAI via Vercel AI Gateway
IMAGE_GENERATION_MODE=fake

# Vercel AI Gateway API key (required when IMAGE_GENERATION_MODE=real)
# The Vercel SDK requires this exact name — do not rename it
AI_GATEWAY_API_KEY=your-vercel-api-gateway-key

# Image model to use via the gateway (e.g. openai/gpt-image-2)
AI_IMAGE_MODEL=openai/gpt-image-2

# OpenAI API key — used for prompt moderation, not image generation directly
# Required when IMAGE_GENERATION_MODE=real
OPENAI_API_KEY=your-openai-api-key

# Supabase Storage bucket for monster images
# Recommended bucket settings: Public: true | Allowed MIME types: image/* | Max size: 10 MB
SUPABASE_STORAGE_BUCKET=monster-images

# Supabase secret (service role) key — server-side only, never expose publicly
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Resend API key for transactional email (magic links + generation-done notifications)
RESEND_API_KEY=your-resend-api-key

# Shared secret used to authenticate internal frontend→backend job-transition calls
# Must be the same value as NEXT_SERVER_SECRET in backend/.env
NEXT_SERVER_SECRET=your-long-random-shared-secret

# When true, the full sanitised prompt is included in Sentry moderation context
# Keep server-only — never use a NEXT_PUBLIC_ prefix
SENTRY_LOG_FULL_MODERATION_PROMPTS=false

# Max image generations allowed per user per rolling 24-hour window
# Must match MAX_GENERATIONS_PER_DAY in backend/.env
MAX_GENERATIONS_PER_DAY=6


# ═════════════════════════════════════════════════════════════════════════════
# BACKEND  →  backend/.env
# ═════════════════════════════════════════════════════════════════════════════

# ── Django core ──────────────────────────────────────────────────────────────

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Enables one-click actions on Django admin pages — development only, never set in production
ENABLE_DEV_ADMIN_ACTIONS=True

# ── CORS ─────────────────────────────────────────────────────────────────────

CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Sentry (optional in local dev) ───────────────────────────────────────────

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────────────────

# Supabase Postgres connection string.
# Use direct connection or session pooler (port 5432).
# Never use the transaction pooler (port 6543) — Django requires prepared statement support.
# Encode special characters in the password with urllib.parse.quote_plus().
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[host]:5432/postgres

# ── Supabase ─────────────────────────────────────────────────────────────────

# Supabase project URL (used for JWT verification)
SUPABASE_URL=https://your-project-ref.supabase.co

# Audience claim expected in Supabase access tokens (default "authenticated" is fine)
SUPABASE_AUTH_AUDIENCE=authenticated

# JWT signing algorithm — check Supabase Dashboard → Authentication → JWT Signing Keys
# ES256 (Elliptic Curve, recommended for new projects) or RS256 (RSA)
SUPABASE_JWT_ALGORITHM=ES256

# ── Shared with frontend ─────────────────────────────────────────────────────

# Shared secret used to authenticate internal frontend→backend job-transition calls
# Must be the same value as NEXT_SERVER_SECRET in frontend/.env.local
NEXT_SERVER_SECRET=your-long-random-shared-secret

# Max image generations allowed per user per rolling 24-hour window
# Must match MAX_GENERATIONS_PER_DAY in frontend/.env.local
MAX_GENERATIONS_PER_DAY=6
